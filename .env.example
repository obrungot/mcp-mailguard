# Environment variables for the MCP server.
# Copy this file to .env and fill in your Entra (Azure AD) application credentials.
# See README.md for setup instructions.

# Microsoft Entra application (client) ID.
GRAPH_CLIENT_ID=

# Directory (tenant) ID, or "consumers" (personal accounts only) / "common" (personal + work).
GRAPH_TENANT_ID=

# Client secret value. Required ONLY for app-only mode (AuthMode=ClientCredentials).
# Not needed for DeviceCode / InteractiveBrowser (delegated) modes.
GRAPH_CLIENT_SECRET=

# Authentication mode: ClientCredentials | DeviceCode | InteractiveBrowser.
#   - DeviceCode: RECOMMENDED for personal (Hotmail/Outlook.com) accounts.
#   - ClientCredentials: app-only, organizational mailboxes only; requires Graph__UserId.
# Leave empty to infer (secret present => ClientCredentials, else DeviceCode).
GRAPH_AUTH_MODE=

# App-only mode only: the mailbox to read (UPN or user id). Required because app-only
# tokens cannot use "/me".
GRAPH_USER_ID=

# Enable the persistent token cache for delegated flows (true/false). Defaults to true.
GRAPH_ENABLE_TOKEN_CACHE=true

# Optional: .NET environment (Development | Production). Defaults to Production.
DOTNET_ENVIRONMENT=Production
