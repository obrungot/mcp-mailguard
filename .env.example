# Copy to .env and fill in. Write values without quotes or spaces around "=". docker compose passes these to the container as-is; the names map to
# configuration keys ("__" separates sections), e.g. Accounts__hotmail__ClientId -> Accounts:hotmail:ClientId.

# --- Server ------------------------------------------------------------------
# Shared secret clients must send as "Authorization: Bearer <key>". Required.
# Generate one with:  openssl rand -base64 32
MailGuard__ApiKey=

# Max characters of an email body / event description returned to the agent.
# MailGuard__MaxBodyChars=20000

# --- Accounts ----------------------------------------------------------------
# Each account has a name (letters, digits, - or _) used as the tools' "account" argument.

# Personal Microsoft account (Hotmail / Outlook.com / Live).
Accounts__hotmail__Provider=Microsoft
# Application (client) ID of your Entra app registration (see README).
Accounts__hotmail__ClientId=
# "consumers" for personal accounts (default). Use "organizations" or a tenant id for work/school.
# Accounts__hotmail__TenantId=consumers

# A work/school Microsoft 365 account could be added the same way:
# Accounts__work__Provider=Microsoft
# Accounts__work__ClientId=
# Accounts__work__TenantId=<tenant id>

# Gmail is not supported yet. When it is, it will look like:
# Accounts__gmail__Provider=Google
# Accounts__gmail__ClientId=
# Accounts__gmail__ClientSecret=

# --- Docker ------------------------------------------------------------------
# Name of the existing Docker network shared with OpenClaw (read by docker compose). Usually the
# network OpenClaw's compose project already has, e.g. openclaw_default (see `docker network ls`).
# Defaults to "openclaw".
# OPENCLAW_NETWORK=openclaw_default
